# MehnatNama Server Environment Configuration
# Use secure, unique values in production environments. Never commit real credentials.

# Application Server
PORT=5001
NODE_ENV=production

# Authoritative PostgreSQL Database (Neon, Render, Supabase, or AWS RDS)
DATABASE_URL="postgresql://username:password@ep-host-pool.region.aws.neon.tech/mehnatnama_db?sslmode=require"

# JWT Authentication (generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret-key-32-bytes"
JWT_EXPIRES_IN="7d"

# Client CORS Origin (Vercel production URL or Custom Domain)
CORS_ORIGIN="https://mehnatnama.vercel.app"

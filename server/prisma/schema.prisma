datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum WorkDayStatus {
  FULL_DAY
  HALF_DAY
  ABSENT
}

enum LedgerEntryType {
  PAYMENT
  ADVANCE
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum SkillLevel {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  HIGHLY_SKILLED
}

enum SkillCategory {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  HIGHLY_SKILLED
}

enum EmploymentSphere {
  CENTRAL
  STATE
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  DISPUTED
  EXPIRED
  REVOKED
}

enum ConfirmationResponseType {
  CONFIRMED
  DISPUTED
}

enum DisputeReason {
  INCORRECT_WORKDAY
  INCORRECT_WAGE_RATE
  WORK_NOT_COMPLETED
  PAYMENT_ALREADY_MADE
  OTHER
}

model User {
  id                         String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone                      String                        @unique @db.VarChar(15)
  pinHash                    String                        @map("pin_hash") @db.VarChar(255)
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile                    WorkerProfile?
  jobs                       Job[]
  workDays                   WorkDay[]
  ledgerEntries              LedgerEntry[]
  auditLogs                  AuditLog[]
  confirmationRequests       ContractorConfirmationRequest[]
  sharedReportAccesses       SharedReportAccess[]

  @@map("users")
}

model WorkerProfile {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String     @unique @map("user_id") @db.Uuid
  fullName          String     @map("full_name") @db.VarChar(100)
  preferredLanguage String     @default("hi") @map("preferred_language") @db.VarChar(10)
  workerType        String     @default("CONSTRUCTION") @map("worker_type") @db.VarChar(50)
  skillLevel        SkillLevel @default(UNSKILLED) @map("skill_level")
  profilePhotoUrl   String?    @map("profile_photo_url") @db.Text
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_profiles")
}

model Job {
  id                   String        @id(map: "jobs_new_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  jobTitle             String        @map("job_title") @db.VarChar(150)
  contractorName       String        @map("contractor_name") @db.VarChar(100)
  contractorPhone      String        @map("contractor_phone") @db.VarChar(15)
  workLocation         String?       @map("work_location") @db.VarChar(255)
  workCategory         String?       @default("Construction") @map("work_category") @db.VarChar(100)
  skillLevel           SkillLevel    @default(UNSKILLED) @map("skill_level")
  agreedDailyRatePaise Int           @map("agreed_daily_rate_paise")
  startDate            DateTime      @map("start_date") @db.Date
  expectedEndDate      DateTime?     @map("expected_end_date") @db.Date
  status               JobStatus     @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDays             WorkDay[]
  ledgerEntries        LedgerEntry[]
  confirmationRequests ContractorConfirmationRequest[]

  @@index([userId])
  @@index([status])
  @@map("jobs")
}

model WorkDay {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  jobId                  String             @map("job_id") @db.Uuid
  workDate               DateTime           @map("work_date") @db.Date
  status                 WorkDayStatus      @default(FULL_DAY)
  dailyRateSnapshotPaise Int                @map("daily_rate_snapshot_paise")
  earnedAmountPaise      Int                @map("earned_amount_paise")
  overtimeMinutes        Int                @default(0) @map("overtime_minutes")
  note                   String?            @db.Text
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                    Job                @relation(fields: [jobId], references: [id], onDelete: Restrict)
  confirmationItems      ConfirmationItem[]

  @@unique([jobId, workDate])
  @@index([userId, workDate])
  @@index([jobId])
  @@map("work_days")
}

model LedgerEntry {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  jobId       String          @map("job_id") @db.Uuid
  type        LedgerEntryType @default(PAYMENT)
  amountPaise Int             @map("amount_paise")
  paymentDate DateTime        @map("payment_date") @db.Date
  paymentMode PaymentMode     @default(CASH) @map("payment_mode")
  note        String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([userId, paymentDate])
  @@index([jobId])
  @@map("ledger_entries")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(50)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model MinimumWageBenchmark {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateCode           String           @map("state_code") @db.VarChar(10)
  sphere              EmploymentSphere @default(STATE)
  scheduledEmployment String           @map("scheduled_employment") @db.VarChar(150)
  skillCategory       SkillCategory    @map("skill_category")
  dailyWagePaise      Int              @map("daily_wage_paise")
  effectiveDate       DateTime         @map("effective_date") @db.Date
  notificationRef     String           @map("notification_ref") @db.VarChar(150)
  authorityName       String           @map("authority_name") @db.VarChar(150)
  sourceUrl           String?          @map("source_url") @db.Text
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([stateCode, skillCategory, isActive])
  @@map("minimum_wage_benchmarks")
}

model ContractorConfirmationRequest {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  jobId           String                  @map("job_id") @db.Uuid
  tokenHash       String                  @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?               @map("revoked_at") @db.Timestamptz(6)
  status          ConfirmationStatus      @default(PENDING)
  title           String?                 @db.VarChar(150)
  note            String?                 @db.Text
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job                     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  items           ConfirmationItem[]
  auditEvents     ConfirmationAuditEvent[]

  @@index([userId, status])
  @@index([jobId])
  @@map("contractor_confirmation_requests")
}

model ConfirmationItem {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String                  @map("request_id") @db.Uuid
  workDayId   String                  @map("work_day_id") @db.Uuid
  status      ConfirmationStatus      @default(PENDING)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  request     ContractorConfirmationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workDay     WorkDay                 @relation(fields: [workDayId], references: [id], onDelete: Cascade)
  responses   ConfirmationResponse[]

  @@unique([requestId, workDayId])
  @@index([requestId])
  @@index([workDayId])
  @@map("confirmation_items")
}

model ConfirmationResponse {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId          String                    @map("item_id") @db.Uuid
  responseType    ConfirmationResponseType  @map("response_type")
  disputeReason   DisputeReason?            @map("dispute_reason")
  optionalComment String?                   @map("optional_comment") @db.Text
  responderIp     String?                   @map("responder_ip") @db.VarChar(45)
  submittedAt     DateTime                  @default(now()) @map("submitted_at") @db.Timestamptz(6)

  item            ConfirmationItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("confirmation_responses")
}

model ConfirmationAuditEvent {
  id          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String                        @map("request_id") @db.Uuid
  eventType   String                        @map("event_type") @db.VarChar(50)
  metadata    Json?                         @db.JsonB
  ipAddress   String?                       @map("ip_address") @db.VarChar(45)
  userAgent   String?                       @map("user_agent") @db.VarChar(255)
  createdAt   DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  request     ContractorConfirmationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("confirmation_audit_events")
}

model MinimumWageRule {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  state               String           @db.VarChar(50)
  zone                String           @default("Zone A") @db.VarChar(50)
  employmentCategory  String           @map("employment_category") @db.VarChar(150)
  skillLevel          SkillLevel       @default(UNSKILLED) @map("skill_level")
  wagePeriod          String           @default("DAILY") @map("wage_period") @db.VarChar(20)
  baseRatePaise       Int              @map("base_rate_paise")
  variableAllowancePaise Int           @default(0) @map("variable_allowance_paise")
  effectiveFrom       DateTime         @map("effective_from") @db.Date
  effectiveTo         DateTime?        @map("effective_to") @db.Date
  notificationDate    DateTime         @map("notification_date") @db.Date
  officialSourceUrl   String           @map("official_source_url") @db.Text
  sourceReference     String           @map("source_reference") @db.VarChar(255)
  verificationStatus  String           @default("VERIFIED") @map("verification_status") @db.VarChar(50)
  verifiedAt          DateTime?        @map("verified_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([state, employmentCategory, skillLevel])
  @@index([effectiveFrom, effectiveTo])
  @@map("minimum_wage_rules")
}

model SharedReportAccess {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  jobId       String?           @map("job_id") @db.Uuid
  tokenHash   String            @unique @map("token_hash") @db.VarChar(64)
  helperName  String?           @map("helper_name") @db.VarChar(100)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(6)
  startDate   DateTime?         @map("start_date") @db.Date
  endDate     DateTime?         @map("end_date") @db.Date
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLogs  HelperAccessLog[]

  @@index([userId])
  @@map("shared_report_accesses")
}

model HelperAccessLog {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accessId  String             @map("access_id") @db.Uuid
  action    String             @db.VarChar(50)
  ipAddress String?            @map("ip_address") @db.VarChar(45)
  userAgent String?            @map("user_agent") @db.VarChar(255)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  access    SharedReportAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)

  @@index([accessId, createdAt])
  @@map("helper_access_logs")
}


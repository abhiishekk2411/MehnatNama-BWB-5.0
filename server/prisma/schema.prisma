datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum JobStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum WorkDayStatus {
  FULL_DAY
  HALF_DAY
  ABSENT
}

enum LedgerEntryType {
  PAYMENT
  ADVANCE
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  OTHER
}

enum SkillLevel {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  HIGHLY_SKILLED
}

enum SkillCategory {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  HIGHLY_SKILLED
}

enum EmploymentSphere {
  CENTRAL
  STATE
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone         String         @unique @db.VarChar(15)
  pinHash       String         @map("pin_hash") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile       WorkerProfile?
  jobs          Job[]
  workDays      WorkDay[]
  ledgerEntries LedgerEntry[]
  auditLogs     AuditLog[]

  @@map("users")
}

model WorkerProfile {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String     @unique @map("user_id") @db.Uuid
  fullName          String     @map("full_name") @db.VarChar(100)
  preferredLanguage String     @default("hi") @map("preferred_language") @db.VarChar(10)
  workerType        String     @default("CONSTRUCTION") @map("worker_type") @db.VarChar(50)
  skillLevel        SkillLevel @default(UNSKILLED) @map("skill_level")
  profilePhotoUrl   String?    @map("profile_photo_url") @db.Text
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_profiles")
}

model Job {
  id                   String        @id(map: "jobs_new_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  jobTitle             String        @map("job_title") @db.VarChar(150)
  contractorName       String        @map("contractor_name") @db.VarChar(100)
  contractorPhone      String        @map("contractor_phone") @db.VarChar(15)
  workLocation         String?       @map("work_location") @db.VarChar(255)
  workCategory         String?       @default("Construction") @map("work_category") @db.VarChar(100)
  skillLevel           SkillLevel    @default(UNSKILLED) @map("skill_level")
  agreedDailyRatePaise Int           @map("agreed_daily_rate_paise")
  startDate            DateTime      @map("start_date") @db.Date
  expectedEndDate      DateTime?     @map("expected_end_date") @db.Date
  status               JobStatus     @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDays             WorkDay[]
  ledgerEntries        LedgerEntry[]

  @@index([userId])
  @@index([status])
  @@map("jobs")
}

model WorkDay {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String        @map("user_id") @db.Uuid
  jobId                  String        @map("job_id") @db.Uuid
  workDate               DateTime      @map("work_date") @db.Date
  status                 WorkDayStatus @default(FULL_DAY)
  dailyRateSnapshotPaise Int           @map("daily_rate_snapshot_paise")
  earnedAmountPaise      Int           @map("earned_amount_paise")
  overtimeMinutes        Int           @default(0) @map("overtime_minutes")
  note                   String?       @db.Text
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job                    Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, workDate])
  @@index([userId, workDate])
  @@index([jobId])
  @@map("work_days")
}

model LedgerEntry {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  jobId       String          @map("job_id") @db.Uuid
  type        LedgerEntryType @default(PAYMENT)
  amountPaise Int             @map("amount_paise")
  paymentDate DateTime        @map("payment_date") @db.Date
  paymentMode PaymentMode     @default(CASH) @map("payment_mode")
  note        String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([userId, paymentDate])
  @@index([jobId])
  @@map("ledger_entries")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(50)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model MinimumWageBenchmark {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateCode           String           @map("state_code") @db.VarChar(10)
  sphere              EmploymentSphere @default(STATE)
  scheduledEmployment String           @map("scheduled_employment") @db.VarChar(150)
  skillCategory       SkillCategory    @map("skill_category")
  dailyWagePaise      Int              @map("daily_wage_paise")
  effectiveDate       DateTime         @map("effective_date") @db.Date
  notificationRef     String           @map("notification_ref") @db.VarChar(150)
  authorityName       String           @map("authority_name") @db.VarChar(150)
  sourceUrl           String?          @map("source_url") @db.Text
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([stateCode, skillCategory, isActive])
  @@map("minimum_wage_benchmarks")
}
